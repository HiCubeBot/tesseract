# Settings for the Compose stack - copy to .env and adjust:
#   cp .env.example .env
# All TESSERACT_* variables go to the controller. Empty or commented out = default.
# After an update: "tesseract env migrate" brings your .env up to date and keeps
# your values (see docs/operations.md).

# ---------- Compose profiles (optional services) ----------
# Which optional services "docker compose up -d" starts as well (comma-separated):
#   anubis        bot protection (proof of work against AI crawlers and scrapers)
#   victorialogs  log storage for long retention (less RAM than Loki)
#   loki          log storage for Grafana (alternative to victorialogs)
#   docker        read-only Docker socket proxy for hosts from container labels
# Empty = only Tesseract and Caddy.
COMPOSE_PROFILES=anubis,victorialogs
# Image version of Tesseract and Caddy (default: latest)
# TESSERACT_VERSION=1.29.0

# ---------- Basics ----------

# Domain of the web interface (gets a Let's Encrypt certificate; internal names like
# tesseract.lan get one from Caddy's own CA)
TESSERACT_DOMAIN=tesseract.example.com

# Cloudflare API token (permissions "Zone - Zone - Read" and "Zone - DNS - Edit") for DNS-01.
# Set = the web interface also gets its certificate via DNS - no port forwarding and no
# public DNS record needed, e.g. for tesseract.home.example.com inside your home network only.
# Applied on every start and locked in the web interface.
# TESSERACT_CLOUDFLARE_TOKEN=
# TESSERACT_CLOUDFLARE_TOKEN_FILE=/run/secrets/cloudflare
TESSERACT_LOG_LEVEL=info

# ---------- Admin access ----------

# Admin user name
TESSERACT_ADMIN_USERNAME=admin
# Networks the web interface is reachable from (comma-separated). From other networks Caddy
# drops the connection without an answer. Invitations (/e/...), device renewal (/v) and the
# agent interface stay reachable everywhere. People with access via device certificate are
# let through from anywhere. Default: all networks (IPv4 and IPv6).
# TESSERACT_ADMIN_NETWORKS=0.0.0.0/0,::/0
# Example: home network and VPN only
# TESSERACT_ADMIN_NETWORKS=192.168.178.0/24,10.8.0.0/24
# Exclude the node interface (/api/agent/..., install script) from that, so nodes reach the
# controller from any network (default). false = nodes only from these networks as well.
# TESSERACT_AGENT_API_PUBLIC=true
# Password (at least 12 characters). Set = applied on every start, cannot be changed in the
# web interface. Empty = random password on first start (printed in the log).
TESSERACT_ADMIN_PASSWORD=
# Or read it from a file (e.g. Docker secret):
# TESSERACT_ADMIN_PASSWORD_FILE=/run/secrets/tesseract_admin

# Session length without / with "stay signed in"
# TESSERACT_SESSION_HOURS=12
# TESSERACT_SESSION_REMEMBER_DAYS=30

# Master key for encrypted secrets (base64, 32 bytes). Empty = created as secret.key in the
# data volume. Back it up separately from the database!
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# TESSERACT_SECRET_KEY=

# ---------- Fixed settings of the web interface ----------
# Set = applied on every start (overrides changes made in the web interface).

# Email for the Let's Encrypt account
# TESSERACT_ACME_EMAIL=admin@example.com
# Log retention in days
# TESSERACT_LOGS_DAYS=14
# Internal networks (LAN, VPN) for hosts "internal only", comma-separated
# TESSERACT_INTERNAL_NETWORKS=192.168.178.0/24,10.8.0.0/24
# Trusted proxies in front of Caddy (X-Forwarded-For), comma-separated
# TESSERACT_TRUSTED_PROXIES=10.0.0.0/8

# ---------- Log storage (profile "victorialogs" or "loki") ----------
# Additional storage for long retention. Every new log entry is also sent there.
# VictoriaLogs (profile "victorialogs", default above):
TESSERACT_LOKI_URL=http://victorialogs:9428
TESSERACT_LOKI_KIND=victorialogs
# VICTORIALOGS_RETENTION=90d
# ... or Loki (profile "loki") - then use these two lines instead of the two above:
# TESSERACT_LOKI_URL=http://loki:3100
# TESSERACT_LOKI_KIND=loki
# LOKI_RETENTION=2160h
# Read log view and statistics from the log storage instead of the own database
# (goes back as far as the log storage keeps data)
# TESSERACT_LOGS_EXTERNAL=true

# ---------- Bot protection (profile "anubis") ----------
# Then enter http://anubis:8923 under Settings > Integrations > Bot protection and turn it
# on per host under Security.
# Difficulty of the challenge (default 4)
# ANUBIS_DIFFICULTY=4
# Fixed key (64 hex characters: openssl rand -hex 32), so passed challenges survive a restart
# ANUBIS_KEY=
# ANUBIS_VERSION=v1.28.2

# ---------- Docker labels (profile "docker") ----------
# Create hosts automatically from container labels (tesseract.domain, tesseract.port ...).
# Then turn it on under Settings > Integrations.
# TESSERACT_DOCKER_HOST=tcp://docker-proxy:2375

# ---------- Optional ----------

# GeoIP database (.mmdb) for countries in logs and statistics - mount the file as a volume
# TESSERACT_GEOIP_DB=/geoip/country.mmdb
# ... or fetch it automatically and renew it monthly (DB-IP Lite, no account, no restart).
# Only outgoing connection - allow download.db-ip.com in Pi-hole/AdGuard.
# TESSERACT_GEOIP_AUTO=dbip
# With cities on the map (about 100 MB) and/or network operators (ASN):
# TESSERACT_GEOIP_AUTO=dbip-city+asn
# Own ASN database (e.g. GeoLite2-ASN) as a file:
# TESSERACT_GEOIP_ASN_DB=/geoip/asn.mmdb
# Push the config to all nodes on start
# TESSERACT_SYNC_ON_START=true
