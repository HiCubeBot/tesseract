# Einstellungen für den Compose-Stack – kopieren nach .env und anpassen:
#   cp .env.example .env
# Alle TESSERACT_*-Variablen gehen an den Controller. Leere Zeilen/auskommentiert = Standard.

# ---------- Grundlegendes ----------

# Domain der Oberfläche (bekommt ein Let's-Encrypt-Zertifikat, interne Namen wie
# tesseract.lan eines aus Caddys eigener CA)
TESSERACT_DOMAIN=tesseract.beispiel.de
TESSERACT_LOG_LEVEL=info

# ---------- Admin-Zugang ----------

# Benutzername des Admins
TESSERACT_ADMIN_USERNAME=admin
# Passwort (mind. 12 Zeichen). Gesetzt = gilt bei jedem Start und lässt sich in der
# Oberfläche nicht ändern. Leer = Zufallspasswort beim ersten Start (steht im Log).
TESSERACT_ADMIN_PASSWORD=
# Alternativ aus einer Datei lesen (z. B. Docker-Secret):
# TESSERACT_ADMIN_PASSWORD_FILE=/run/secrets/tesseract_admin

# Session: Dauer ohne / mit „angemeldet bleiben“
# TESSERACT_SESSION_HOURS=12
# TESSERACT_SESSION_REMEMBER_DAYS=30

# Hauptschlüssel für verschlüsselte Geheimnisse (Base64, 32 Byte). Leer = wird als
# secret.key im Datenvolume angelegt. Getrennt von der Datenbank sichern!
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# TESSERACT_SECRET_KEY=

# ---------- Einstellungen der Oberfläche festlegen ----------
# Gesetzt = wird bei jedem Start übernommen (überschreibt Änderungen in der Oberfläche).

# E-Mail für das Let's-Encrypt-Konto
# TESSERACT_ACME_EMAIL=admin@beispiel.de
# Aufbewahrung der Logs in Tagen
# TESSERACT_LOGS_DAYS=14
# Interne Netze (LAN, VPN) für Hosts „Nur intern“, kommagetrennt
# TESSERACT_INTERNAL_NETWORKS=192.168.178.0/24,10.8.0.0/24
# Vertrauenswürdige Proxys vor Caddy (X-Forwarded-For), kommagetrennt
# TESSERACT_TRUSTED_PROXIES=10.0.0.0/8
# Loki als zusätzlicher Log-Speicher (Compose-Profil „loki“: docker compose --profile loki up -d)
# TESSERACT_LOKI_URL=http://loki:3100
# Aufbewahrung in Loki (Standard 90 Tage)
# LOKI_RETENTION=2160h

# ---------- Optional ----------

# GeoIP-Datenbank (.mmdb) für Länder in Logs und Statistik – Datei per Volume einbinden
# TESSERACT_GEOIP_DB=/geoip/country.mmdb
# Beim Start die Config an alle Nodes übertragen
# TESSERACT_SYNC_ON_START=true
